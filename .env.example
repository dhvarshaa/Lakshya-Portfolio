# Public site URL (no trailing slash). Used for sitemap, robots, and Open Graph.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Resend — https://resend.com/api-keys
RESEND_API_KEY=re_xxxxxxxx

# Where enquiries are delivered (defaults to Lakshya's Gmail from lib/site.ts)
ENQUIRY_TO_EMAIL=lakshaydh2017@gmail.com

# Must be a verified domain sender in Resend.
# For first tests you can use: Lakshya Yoga <onboarding@resend.dev>
# (Resend only allows sending TO your own signup email with that address.)
ENQUIRY_FROM_EMAIL=Lakshya Yoga <onboarding@resend.dev>
